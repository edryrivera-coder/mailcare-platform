# ============================================================================
# MAILCARE PLATFORM — ENVIRONMENT TEMPLATE (NFA-18: No Secrets in Git)
# ============================================================================

# --- Application & API Gateway ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_GATEWAY_PORT=4000
API_RATE_LIMIT_PER_MIN=100

# --- PostgreSQL (Transactional Metadata - Sec. 23, NFA-12, NFA-17) ---
DATABASE_URL=postgresql://mailcare:mailcare_dev_only@localhost:5432/mailcare?schema=public
DATABASE_READ_REPLICA_URL=postgresql://mailcare:mailcare_dev_only@localhost:5432/mailcare?schema=public

# --- Redis (DNS Cache, Token Buckets, Distributed Locks - Sec. 23) ---
REDIS_URL=redis://localhost:6379
DNS_CACHE_TTL_SECONDS=3600

# --- Object Storage (Ephemeral Batch Uploads/Exports - NFA-13) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_BATCHES=mailcare-batches
S3_RETENTION_DAYS=7

# --- KMS / HSM Envelope Encryption (Sec. 5, NFA-15, NFA-18) ---
KMS_KEY_ID=alias/mailcare-oauth-token-vault

# --- Verification Engine & ML Service (Sec. 14-18, NFA-03, NFA-34) ---
SMTP_HANDSHAKE_TIMEOUT_MS=3000
REALTIME_VERIFY_SLA_MS=1500
ML_SERVICE_INTERNAL_URL=http://localhost:8000
